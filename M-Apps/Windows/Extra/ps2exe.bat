@echo off
setlocal
title PS1 to EXE Converter
set "BAT_DIR=%~dp0"

echo.
echo [INFO] Starting PS1 to EXE Converter...
echo [INFO] Enter a filename or full path when prompted.
echo.

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "& { $ErrorActionPreference = 'Stop'; $exitCode = 0; try { try { $Host.UI.RawUI.WindowTitle = 'PS1 to EXE Converter' } catch {}; $baseDir = [System.IO.Path]::GetFullPath($env:BAT_DIR); Write-Host ''; Write-Host '=== PowerShell Script to EXE Converter ===' -ForegroundColor Cyan; Write-Host ('BAT directory: ' + $baseDir); if (-not (Get-Module -ListAvailable -Name PS2EXE)) { throw 'PS2EXE module is missing. Open Windows PowerShell and run: Install-Module PS2EXE -Scope CurrentUser' }; Import-Module PS2EXE -ErrorAction Stop; if (-not (Get-Command Invoke-PS2EXE -ErrorAction SilentlyContinue)) { throw 'Invoke-PS2EXE was not found after importing PS2EXE.' }; $scriptInput = Read-Host 'Enter PS1 filename or full path (e.g. MyScript or C:\Scripts\MyScript.ps1)'; if ($null -eq $scriptInput) { throw 'No script path was entered.' }; $scriptInput = $scriptInput.Trim(); if ($scriptInput.Length -ge 2 -and $scriptInput[0] -eq [char]34 -and $scriptInput[$scriptInput.Length - 1] -eq [char]34) { $scriptInput = $scriptInput.Substring(1, $scriptInput.Length - 2) }; if ([string]::IsNullOrWhiteSpace($scriptInput)) { throw 'No script path was entered.' }; $scriptExt = [System.IO.Path]::GetExtension($scriptInput); if ([string]::IsNullOrEmpty($scriptExt)) { $scriptInput += '.ps1' } elseif ($scriptExt -ine '.ps1') { throw 'The input file must have a .ps1 extension. You may omit the extension.' }; if ([System.IO.Path]::IsPathRooted($scriptInput)) { $scriptPath = [System.IO.Path]::GetFullPath($scriptInput) } else { $scriptPath = [System.IO.Path]::GetFullPath((Join-Path -Path $baseDir -ChildPath $scriptInput)) }; if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) { throw ('PowerShell script not found: ' + $scriptPath + '. Keep it beside this BAT file or enter its full path.') }; $outputInput = Read-Host 'Enter output EXE name or path (e.g. MyApp or C:\Build\MyApp.exe)'; if ($null -eq $outputInput) { throw 'No output filename was entered.' }; $outputInput = $outputInput.Trim(); if ($outputInput.Length -ge 2 -and $outputInput[0] -eq [char]34 -and $outputInput[$outputInput.Length - 1] -eq [char]34) { $outputInput = $outputInput.Substring(1, $outputInput.Length - 2) }; if ([string]::IsNullOrWhiteSpace($outputInput)) { throw 'No output filename was entered.' }; if ($outputInput.EndsWith('\') -or $outputInput.EndsWith('/')) { throw 'Enter an EXE filename after the output directory.' }; $outputExt = [System.IO.Path]::GetExtension($outputInput); if ([string]::IsNullOrEmpty($outputExt)) { $outputInput += '.exe' } elseif ($outputExt -ine '.exe') { throw 'The output file must use the .exe extension, or you may omit the extension.' }; if ([System.IO.Path]::IsPathRooted($outputInput)) { $outputPath = [System.IO.Path]::GetFullPath($outputInput) } else { $outputPath = [System.IO.Path]::GetFullPath((Join-Path -Path $baseDir -ChildPath $outputInput)) }; if (Test-Path -LiteralPath $outputPath -PathType Container) { throw ('The output path is a directory, not a filename: ' + $outputPath) }; $outputDirectory = [System.IO.Path]::GetDirectoryName($outputPath); [System.IO.Directory]::CreateDirectory($outputDirectory) | Out-Null; $build = $true; if (Test-Path -LiteralPath $outputPath -PathType Leaf) { $overwrite = Read-Host 'Output file already exists. Overwrite? Enter Y to confirm, anything else to cancel'; if ($overwrite.Trim().ToLowerInvariant() -notin @('y','yes')) { Write-Host '[INFO] Conversion cancelled; existing EXE was kept.' -ForegroundColor Yellow; $build = $false } }; if ($build) { Write-Host ''; Write-Host ('[INFO] Source: ' + $scriptPath); Write-Host ('[INFO] Output: ' + $outputPath); Write-Host '[INFO] Compiling with PS2EXE...' -ForegroundColor Cyan; Invoke-PS2EXE -InputFile $scriptPath -OutputFile $outputPath -ErrorAction Stop; if (-not (Test-Path -LiteralPath $outputPath -PathType Leaf)) { throw 'PS2EXE returned without creating the requested EXE.' }; $exeInfo = Get-Item -LiteralPath $outputPath -ErrorAction Stop; if ($exeInfo.Length -le 0) { throw 'The output EXE exists but is empty.' }; Write-Host ''; Write-Host '[SUCCESS] EXE created successfully.' -ForegroundColor Green; Write-Host ('Output file: ' + $outputPath) } } catch { Write-Host ''; Write-Host ('[ERROR] ' + $_.Exception.Message) -ForegroundColor Red; $exitCode = 1 }; Write-Host ''; Read-Host 'Press Enter to close this window' | Out-Null; exit $exitCode }"

exit /b %errorlevel%
